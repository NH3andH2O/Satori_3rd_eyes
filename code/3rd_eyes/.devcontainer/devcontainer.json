{
	"name": "ESP-IDF QEMU",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"remoteUser": "root",
	"mounts": [
		"source=esp-idf-qemu-vscode-user-data,target=/root/.vscode-server/data/User,type=volume",
		"source=esp-idf-qemu-copilot-home,target=/root/.copilot,type=volume",
		"source=${localWorkspaceFolderBasename}-build,target=${containerWorkspaceFolder}/build,type=volume",
		"source=${localWorkspaceFolderBasename}-ccache,target=/root/.ccache,type=volume"
	],
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"idf.gitPath": "/usr/bin/git"
			},
			"extensions": [
				"espressif.esp-idf-extension",
				"espressif.esp-idf-web",
				"ms-vscode.vscode-serial-monitor",
				"ms-vscode.cpptools"
			]
		}
	},
	"runArgs": [
		"--privileged"
	]
}