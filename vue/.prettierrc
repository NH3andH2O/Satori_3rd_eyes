{
	"semi": true,
	"trailingComma": "all",
	"singleQuote": true,
	"printWidth": 150,
	"tabWidth": 4,
	"useTabs": true,
	"endOfLine": "lf",
	"arrowParens": "always",
	"bracketSpacing": true,
	"quoteProps": "as-needed",
	"vueIndentScriptAndStyle": false,
	"htmlWhitespaceSensitivity": "css",
	"bracketSameLine": false
}
